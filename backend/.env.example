# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM ---------------------------------------------------------------------
# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- Data stores -----------------------------------------------------------
# Async Postgres connection string (must use the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/leadqual
# Redis connection string (reserved for future queue/cache use)
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth (Gmail send, Calendar, Drive/Sheets connector) ----------
# Create an OAuth 2.0 "Desktop app" client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
